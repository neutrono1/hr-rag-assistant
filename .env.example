# --- LLM provider: groq | gemini | ollama ---
LLM_PROVIDER=groq

# Groq (https://console.groq.com) — free tier, OpenAI-compatible, fast.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (https://aistudio.google.com) — free tier alternative.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama — fully local fallback, no key needed. Requires `ollama serve`.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Embeddings: always local/free via sentence-transformers ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval / grounding knobs ---
TOP_K=5
MIN_SIMILARITY=0.30
CHUNK_TARGET_CHARS=700
CHUNK_OVERLAP_CHARS=120

# --- Storage ---
DB_PATH=data/hr_rag.sqlite3
UPLOAD_DIR=data/raw_docs
